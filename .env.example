# =============================================================================
# DEX JURÍDICO — MODELO DE VARIÁVEIS DE AMBIENTE (.env.example)
# =============================================================================

# --- OPÇÃO 1: Envio por Gmail / SMTP (Recomendado para domínio público) ---
# Use seu Gmail: confirm.dex@gmail.com
# Gere uma "Senha de App" de 16 caracteres em: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=confirm.dex@gmail.com
SMTP_PASS=sua_senha_de_app_aqui_16_letras
EMAIL_FROM="Dex Jurídico <confirm.dex@gmail.com>"

# --- OPÇÃO 2: Resend (Apenas se tiver domínio próprio com DNS configurado) ---
RESEND_API_KEY=
# EMAIL_FROM="Dex Jurídico <nao-responda@seudominio.com.br>"

APP_URL=https://dexjuridico.vercel.app

# --- Inteligência Artificial Dex AI ---
# Chave da API Google Gemini para assistente e triagem forense
GEMINI_API_KEY=

# --- Banco de Dados e Nuvem (Supabase) ---
# Opcional caso utilize sincronização na nuvem além do IndexedDB local
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica
SUPABASE_SERVICE_ROLE_KEY=sua-chave-service-role-privada-apenas-backend

# --- Credenciais da Conta Demonstração e Admin Geral ---
VITE_DEMO_EMAIL=demo@dexjuridico.adv.br
VITE_DEMO_PASSWORD=DemoApresentacao2026!
VITE_APP_ADMIN_EMAIL=otton.luis.alcaraz@gmail.com

